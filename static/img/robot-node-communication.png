   xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd"
   xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape"
   width="600"
   height="400"
   viewBox="0 0 600 400"
   id="svg2"
   version="1.1"
   inkscape:version="1.0.2 (e86c870879, 2021-01-14)"
   sodipodi:docname="robot-node-communication.png">
  <defs
     id="defs4" />
  <sodipodi:namedview
     id="base"
     pagecolor="#ffffff"
     bordercolor="#666666"
     borderopacity="1.0"
     inkscape:pageopacity="0.0"
     inkscape:pageshadow="2"
     inkscape:zoom="1"
     inkscape:cx="300"
     inkscape:cy="200"
     inkscape:document-units="px"
     inkscape:current-layer="layer1"
     showgrid="false"
     units="px"
     inkscape:window-width="1920"
     inkscape:window-height="1017"
     inkscape:window-x="-8"
     inkscape:window-y="-8"
     inkscape:window-maximized="1" />
  <metadata
     id="metadata7">
    <rdf:RDF>
      <cc:Work
         rdf:about="">
        <dc:format>image/svg+xml</dc:format>
        <dc:type
           rdf:resource="http://purl.org/dc/dcmitype/StillImage" />
        <dc:title>Robot Node Communication</dc:title>
      </cc:Work>
    </rdf:RDF>
  </metadata>
  <g
     inkscape:label="Layer 1"
     inkscape:groupmode="layer"
     id="layer1">
    <!-- Background -->
    <rect
       style="fill:#f8f9fa;fill-opacity:1;stroke:none"
       id="rect815"
       width="600"
       height="400"
       x="0"
       y="0" />

    <!-- Title -->
    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:20px;line-height:1.25;font-family:sans-serif;fill:#2e8555;fill-opacity:1;stroke:none"
       x="300"
       y="40"
       id="text819"
       text-anchor="middle">
      <tspan
         sodipodi:role="line"
         id="tspan817"
         x="300"
         y="40">Robot Node Communication</tspan>
    </text>

    <!-- AI Node -->
    <rect
       style="fill:#4285f4;fill-opacity:1;stroke:#1a73e8;stroke-width:2;stroke-opacity:1"
       id="rect821"
       width="120"
       height="80"
       x="80"
       y="150"
       ry="10" />
    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:14px;line-height:1.25;font-family:sans-serif;fill:#ffffff;fill-opacity:1;stroke:none"
       x="140"
       y="180"
       id="text825"
       text-anchor="middle">
      <tspan
         sodipodi:role="line"
         id="tspan823"
         x="140"
         y="180">AI Node</tspan>
      <tspan
         sodipodi:role="line"
         x="140"
         y="197.5"
         id="tspan827">(Python)</tspan>
    </text>

    <!-- Robot -->
    <rect
       style="fill:#34a853;fill-opacity:1;stroke:#1e8e3e;stroke-width:2;stroke-opacity:1"
       id="rect829"
       width="120"
       height="80"
       x="400"
       y="150"
       ry="10" />
    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:14px;line-height:1.25;font-family:sans-serif;fill:#ffffff;fill-opacity:1;stroke:none"
       x="460"
       y="180"
       id="text833"
       text-anchor="middle">
      <tspan
         sodipodi:role="line"
         id="tspan831"
         x="460"
         y="180">Robot</tspan>
      <tspan
         sodipodi:role="line"
         x="460"
         y="197.5"
         id="tspan835">(Hardware)</tspan>
    </text>

    <!-- Topic Arrow -->
    <line
       style="fill:none;stroke:#fbbc04;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-opacity:1"
       x1="200"
       y1="180"
       x2="400"
       y2="180"
       id="line837"
       marker-end="url(#arrowhead)" />

    <!-- Return Arrow -->
    <line
       style="fill:none;stroke:#fbbc04;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-opacity:1;stroke-dasharray:6,6"
       x1="400"
       y1="200"
       x2="200"
       y2="200"
       id="line839"
       marker-end="url(#arrowhead)" />

    <!-- Topic Label -->
    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:12px;line-height:1.25;font-family:sans-serif;fill:#fbbc04;fill-opacity:1;stroke:none"
       x="300"
       y="170"
       id="text843"
       text-anchor="middle">
      <tspan
         sodipodi:role="line"
         id="tspan841"
         x="300"
         y="170">/cmd_vel</tspan>
    </text>

    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:12px;line-height:1.25;font-family:sans-serif;fill:#fbbc04;fill-opacity:1;stroke:none"
       x="300"
       y="215"
       id="text847"
       text-anchor="middle">
      <tspan
         sodipodi:role="line"
         id="tspan845"
         x="300"
         y="215">/sensor_data</tspan>
    </text>

    <!-- Arrowhead definition -->
    <defs>
      <marker
         id="arrowhead"
         markerWidth="10"
         markerHeight="7"
         refX="9"
         refY="3.5"
         orient="auto">
        <polygon
           points="0,0 10,3.5 0,7"
           fill="#fbbc04" />
      </marker>
    </defs>

    <!-- Legend -->
    <rect
       style="fill:#ffffff;fill-opacity:1;stroke:#cccccc;stroke-width:1;stroke-opacity:1"
       id="rect850"
       width="160"
       height="60"
       x="20"
       y="320" />
    <text
       xml:space="preserve"
       style="font-style:normal;font-weight:normal;font-size:12px;line-height:1.25;font-family:sans-serif;fill:#000000;fill-opacity:1;stroke:none"
       x="30"
       y="340"
       id="text854">
      <tspan
         sodipodi:role="line"
         id="tspan852"
         x="30"
         y="340">Solid: Commands</tspan>
      <tspan
         sodipodi:role="line"
         x="30"
         y="355"
         id="tspan856">Dashed: Sensor Data</tspan>
      <tspan
         sodipodi:role="line"
         x="30"
         y="370"
         id="tspan858">Yellow: ROS Topic</tspan>
    </text>
  </g>
